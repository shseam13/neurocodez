#===============================================================================
# Neuro Codez — environment template
#
# Copy to .env for local development. Where local and production differ, the
# production value is called out in the comment. Full walkthrough: DEPLOYMENT.md
#===============================================================================

APP_NAME="Neuro Codez"
APP_ENV=local
# php artisan key:generate --show
# Set ONCE per environment and never rotate: changing the key makes every
# existing session and encrypted value unreadable.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Production (Render): LOG_CHANNEL=stderr — there is no persistent disk.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-------------------------------------------------------------------------------
# Database — MySQL, not Postgres
#
# The MySQL choice is what keeps a later move to cPanel a config change rather
# than a rewrite. Free managed option: Aiven (1 GB, always free).
#-------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neuro_codez
DB_USERNAME=neuro_app
DB_PASSWORD=

# Aiven requires TLS. Download their CA and point this at it in production:
# MYSQL_ATTR_SSL_CA=/var/www/html/storage/certs/aiven-ca.pem

#-------------------------------------------------------------------------------
# Session, cache, queue
#
# LOCAL uses file — simple and fast on a stable disk.
#
# PRODUCTION MUST USE database for all three. Render's filesystem is EPHEMERAL:
# file sessions would sign everyone out on every deploy, and a file cache would
# silently vanish mid-request.
#-------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

#-------------------------------------------------------------------------------
# File storage
#
# LOCAL uses `local` (storage/app/private) — deliberately not web-accessible.
#
# PRODUCTION MUST USE s3 pointed at Cloudflare R2 (10 GB free). A redeploy wipes
# the container disk, which would destroy every client deliverable ever uploaded.
# Each file records its own disk, so switching is config only.
#-------------------------------------------------------------------------------
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

#-------------------------------------------------------------------------------
# Mail
#
# `log` writes emails into storage/logs/laravel.log — fine locally, useless in
# production. Invitations and password resets do nothing without a real sender.
# Free tiers: Brevo (300/day), Resend (3,000/month).
#-------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="neurocodez.tech@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

#-------------------------------------------------------------------------------
# Neuro Codez settings
#-------------------------------------------------------------------------------
# An @handle is fine — it is resolved to the UC… id once and cached 30 days.
NEURO_YOUTUBE_CHANNEL="@neuro-codez"

NEURO_PUBLIC_EMAIL="neurocodez.tech@gmail.com"
NEURO_PUBLIC_PHONE="+8801626-014236"
NEURO_WHATSAPP="+8801626014236"

NEURO_SOCIAL_YOUTUBE="https://www.youtube.com/@neuro-codez"
NEURO_SOCIAL_FACEBOOK="https://www.facebook.com/profile.php?id=61564889531223"
NEURO_SOCIAL_INSTAGRAM="https://instagram.com/neuro_codez"

NEURO_CURRENCY=BDT
NEURO_INVOICE_DUE_DAYS=14

# Leave false until a Bengali-capable font is registered with dompdf. Otherwise
# ৳ (U+09F3) prints as an empty box — DejaVu carries no Bengali script.
NEURO_TAKA_GLYPH=false

# Used once, by `php artisan db:seed`, to create the first owner account.
SEED_OWNER_NAME="Neuro Codez Owner"
SEED_OWNER_EMAIL="seam.cse.pciu@gmail.com"
SEED_OWNER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
