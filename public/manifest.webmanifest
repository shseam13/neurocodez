{
    "name": "Neuro Codez",
    "short_name": "Neuro Codez",
    "description": "Clients, projects, payments and commissions for Neuro Codez.",
    "id": "/dashboard",
    "start_url": "/dashboard",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait-primary",
    "background_color": "#1E073A",
    "theme_color": "#1E073A",
    "lang": "en",
    "dir": "ltr",
    "icons": [
        {
            "src": "/brand/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/brand/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/brand/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Projects",
            "url": "/admin/projects",
            "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Commissions payable",
            "url": "/admin/payouts",
            "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192" }]
        }
    ]
}
